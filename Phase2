        "# Grover diffusion\n",
        "def diffusion():\n",
        "    return [\n",
        "        cirq.H.on_each(*qubits),\n",
        "        cirq.X.on_each(*qubits),\n",
        "        cirq.CZ(qubits[0], qubits[1]),\n",
        "        cirq.X.on_each(*qubits),\n",
        "        cirq.H.on_each(*qubits)\n",
        "    ]\n",
        "\n",
        "# Build Grover circuit\n",
        "circuit = cirq.Circuit()\n",
        "circuit.append(cirq.H.on_each(*qubits))   # Superposition\n",
